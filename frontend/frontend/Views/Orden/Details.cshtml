@model backend.Models.Orden

<main class="main" id="main">
    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Detalles de la Orden</h5>
                        <p>
                            A continuación, se muestra la información detallada de la orden seleccionada, incluyendo los productos y cantidades ordenadas.
                        </p>

                        <dl class="row">
                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.DetalleOrden.Precio)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.DetalleOrden.Precio)
                            </dd>

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.DetalleOrden.Cantidad_Platillo)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.DetalleOrden.Cantidad_Platillo)
                            </dd>

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.DetalleOrden.Cantidad_Bebida)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.DetalleOrden.Cantidad_Bebida)
                            </dd>

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.DetalleOrden.Platillo.Nombre)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.DetalleOrden.Platillo.Nombre)
                            </dd>

                            <dt class="col-sm-2">
                                @Html.DisplayNameFor(model => model.DetalleOrden.Bebida.Nombre)
                            </dt>
                            <dd class="col-sm-10">
                                @Html.DisplayFor(model => model.DetalleOrden.Bebida.Nombre)
                            </dd>
                        </dl>

                        <div class="mt-3">
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.Id_Orden">Editar</a>
                            <a class="btn btn-secondary" asp-action="Index">Atrás</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>