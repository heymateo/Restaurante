@using Models
@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<h2>@ViewData["Title"]</h2>

<div class="form-group">
    <label>Nombre:</label>
    <p>@Model.Nombre</p>
</div>

<div class="form-group">
    <label>Correo:</label>
    <p>@Model.Correo</p>
</div>

<div class="form-group">
    <label>Tipo de Usuario:</label>
    <p>@Model.TipoUsuario</p>
</div>

<div class="form-group">
    <a asp-action="EditProfile" class="btn btn-warning">Edit Profile</a>
</div>
