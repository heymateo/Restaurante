@model List<backend.Models.Administrador>

<main id="main" class="main">

    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Lista de Administradores</h5>
                <p>
                    Bienvenido a la sección de administración de súper usuarios. Aquí encontrará una lista completa de administradores registrados en el sistema. 
                    Desde esta página, puede editar la información de cada administrador, incluyendo su nombre, correo electrónico y otros detalles relevantes. 
                    Además, tiene la opción de desactivar administradores según sea necesario.
                </p>

                <!-- Table with stripped rows -->
                <table class="table table-hover datatable">
                    <thead>
                        <tr>
                            <th scope="col">Nombre</th>
                            <th scope="col">Correo</th>
                            <th scope="col">Activo</th>
                            <th scope="col">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model)
                        {
                            <tr>
                                <td>@admin.Nombre</td>
                                <td>@admin.Correo</td>
                                <td>@admin.Activo</td>
                                <td class="btn-group" role="group">
                                    <a type="button" class="btn btn-primary" href="@Url.Action("Edit", new { id = admin.Id_Administrador })">Editar</a>
                                    <a type="button" class="btn btn-danger" href="@Url.Action("Deactivate", new { id = admin.Id_Administrador })">Desactivar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- End Table with stripped rows -->

            </div>
        </div>
    </div>

        

</main><!-- End #main -->
