@model List<backend.Models.Cliente>

<main id="main" class="main">

    <div class="pagetitle">
        <h5 class="card-title">Lista de Clientes</h5>
        <p>
            Bienvenido a la sección de administración de Clientes. Aquí encontrará una lista completa de clientes registrados en el sistema.
        </p>
    </div><!-- End Page Title -->

    <section class="section" class="main">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Clientes</h5>
  
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    
                                    <th scope="col">Nombre</th>
                                    <th scope="col">Apellido</th>
                                  
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var chef in Model)
                                {
                                    <tr>
                                        
                                        <td>@chef.Nombre</td>
                                        <td>@chef.Apellido</td>
                                       
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <!-- End Table with stripped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->
