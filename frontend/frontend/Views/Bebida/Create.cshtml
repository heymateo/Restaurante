@model backend.Models.Bebida


<main id="main" class="main">

    <section class="section">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Crear Bebida</h5>
                        <p>Add lightweight datatables to your project with using the <a href="https://github.com/fiduswriter/Simple-DataTables" target="_blank">Simple DataTables</a> library. Just add <code>.datatable</code> class name to any table you wish to conver to a datatable. Check for <a href="https://fiduswriter.github.io/simple-datatables/demos/" target="_blank">more examples</a>.</p>
                    
                        <!-- Floating Labels Form -->
                        <form class="row g-3" asp-action="Create" method="post">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Nombre" type="text" class="form-control" id="floatingName" placeholder="Nombre">
                                    <label asp-for="Nombre"></label>
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea asp-for="Descripcion" type="text" class="form-control" id="floatingName" placeholder="Descripcion" style="height: 100px"></textarea>

                                    <label asp-for="Descripcion"></label>
                                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="input-group">
                                    <span class="input-group-text">₡</span>
                                    <input asp-for="Precio" type="text" class="form-control" aria-label="Amount (to the nearest dollar)">
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Id_Categoria" type="text" class="form-control" id="floatingCategoria" placeholder="Categoria">
                                        <option value="">Seleccione una categoria</option>
                                        @* @foreach (var categoria in Model.ListaCategorias)
                                        {
                                            <option value="@categoria.Id_Categoria">@categoria.Nombre</option>
                                        } *@
                                    </select>
                                </div>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary">Crear</button>
                                <a asp-action="Index" asp-controller="MenuView" class="btn btn-secondary">Regresar</a>
                            </div>
                        </form><!-- End floating Labels Form -->
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
