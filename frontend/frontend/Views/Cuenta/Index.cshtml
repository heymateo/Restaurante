@model IEnumerable<frontend.Models.CuentaModel>

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Lista de Cuentas</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                <li class="breadcrumb-item">Tables</li>
                <li class="breadcrumb-item active">General</li>
            </ol>
        </nav>
    </div><!-- End Page Title -->

    <section class="section">

        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Id_Cliente)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Id_Orden)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Total)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.First().Cancelado)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id_Cliente)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id_Orden)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Total)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Cancelado)
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </section><!-- End .section -->

</main><!-- End #main -->
