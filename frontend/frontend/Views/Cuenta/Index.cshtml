@model IEnumerable<backend.Models.Cuenta>

<main id="main" class="main">

    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Lista de Cuentas</h5>
                <p>
                    Bienvenido a la sección de administración de cuentas. Aquí encontrará una lista completa de cuentas registradas en el sistema.
                    Desde esta página, puede revisar la información de cada cuenta, incluyendo el nombre del cliente y otros detalles relevantes.
                </p>

                <section class="section">

                    <table class="table table-hover datatable">
                        <thead>
                            <tr>
                                <th scope="col">Nombre del Cliente</th>
                                <th scope="col">Número de Orden</th>
                                <th scope="col">Total</th>
                                <th scope="col">Cancelado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td scope="col">@item.Cliente?.Nombre</td>
                                    <td scope="col">@item.Orden?.Numero_Orden</td>
                                    <td scope="col">₡@item.Total</td>
                                    <td scope="col">
                                        <input type="checkbox" disabled @(item.Cancelado ? "checked" : "") />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </section><!-- End .section -->
            </div>
        </div>
    </div>

</main><!-- End #main -->
