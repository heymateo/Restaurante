@model backend.Models.Mesa

<main id="main" class="main">

    <div class="col-lg-12">

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Editar Mesa</h5>

                <!-- Floating Labels Form -->
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id_Mesa" />
                    <div class="form-group">
                        <label asp-for="Numero_Mesa" class="control-label"></label>
                        <input asp-for="Numero_Mesa" class="form-control" />
                        <span asp-validation-for="Numero_Mesa" class="text-danger"></span>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="Disponible" /> @Html.DisplayNameFor(model => model.Disponible)
                        </label>
                    </div>
                    <div class="form-group form-check">
                        <label class="form-check-label">
                            <input class="form-check-input" asp-for="Activa" /> @Html.DisplayNameFor(model => model.Activa)
                        </label>
                    </div>
                    <br />
                    <div class="form-group">
                        <input type="submit" value="Guardar" class="btn btn-primary" />
                        <a type="button" class="btn btn-secondary" asp-action="Index">Regresar</a>
                    </div>
                </form><!-- End floating Labels Form -->

            </div>
        </div>

    </div>

</main><!-- End #main -->

