@model List<backend.Models.Chef>

<main id="main" class="main">

    <div class="pagetitle">
        <h5 class="card-title">Lista de Chefs</h5>
        <p>
            Bienvenido a la sección de gestión de chefs. Aquí encontrará una lista completa de chefs registrados en el sistema.
    </div><!-- End Page Title -->

    <section class="section" class="main">
        <div class="row">
            <div class="col-lg-12">

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Chef</h5>


                        <!-- Table with stripped rows -->
                        <table class="table datatable">
                            <thead>
                                <tr>
                                    <th scope="col">Nombre</th>
                                    <th scope="col">Correo</th>
                                    <th scope="col">Activo</th>

                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var chef in Model)
                                {
                                    <tr>
                                        <td>@chef.Nombre</td>
                                        <td>@chef.Correo</td>
                                        <td>@chef.Activo</td>
                                        <td>
                                            <a type="button" class="btn btn-primary" href="@Url.Action("Edit", new { id = chef.Id_Chef })">Editar</a>
                                            <a type="button" class="btn btn-danger" href="@Url.Action("Deactivate", new { id = chef.Id_Chef })">Desactivar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <!-- End Table with stripped rows -->

                    </div>
                </div>

            </div>
        </div>
    </section>

</main><!-- End #main -->
